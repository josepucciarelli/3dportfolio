# Cache del navegador: los archivos de /assets tienen hash en el nombre
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|png|jpg|svg|glb|mp4|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml model/gltf-binary
</IfModule>
